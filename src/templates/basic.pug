include ../components/mixins.pug

doctype html
html(lang="ru")
    include ../components/head.pug

    body
        .wrapper
            header.header
                .container
                    p.header__title Header
                nav.header__menu.menu
                    .container
                        ul.menu__list
                            +liLink('#', 'Главная', '')
                            +liLink('#', 'Статьи', '')
                            +liLink('#', 'Новости', '')


            main.main
                .container
                    block main


            footer.footer
                .container
                    .footer-wrapper
                        nav.footer__menu.menu
                            ul.menu__list
                                +liLink('#', 'Меню', '')

        include ../components/scripts.pug