include ../components/mixins.pug

doctype html
html(lang="ru")
    include ../components/head.pug

    body
        .wrapper
            header.header
                .container
                    p.title.header__title Header
                nav.header__menu.menu
                    .container
                        ul.menu__list
                            +liLink('#', 'Главная', '')
                            +liLink('#', 'Статьи', '')
                            +liLink('#', 'Новости', '')


            main.main
                block main


            footer.footer
                .container
                    p.title.header__title Footer

        include ../components/scripts.pug